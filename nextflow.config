manifest {
    name = 'codework/genome-runtime'
    version = '0.5.0'
    // Upper bound as well as lower: an open-ended range accepts a future major
    // release whose DSL changes silently alter what these workflows mean.
    nextflowVersion = '!>=26.04.6, <27.0.0'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']
}

timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
