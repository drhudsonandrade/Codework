manifest {
    name = 'codework/genome-runtime-canary'
    version = '0.1.0'
    nextflowVersion = '!26.04.6'
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash', '-euo', 'pipefail']
}

timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
