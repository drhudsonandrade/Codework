[Unit]
Description=OpenAI Secure MCP Tunnel client for OmniGenis genome MCP
Wants=network-online.target genome-mcp.service
After=network-online.target genome-mcp.service

[Service]
Type=simple
User=genome
Group=genome
EnvironmentFile=/etc/omnigenis/tunnel-client.env
ExecStart=/usr/local/bin/tunnel-client run --profile omnigenis-genome
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/omnigenis-tunnel

[Install]
WantedBy=multi-user.target
